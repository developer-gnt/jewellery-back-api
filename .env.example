# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zewar_mahal
DB_USER=postgres
DB_PASS=postgres
DB_SYNC=false
DB_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=300

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_zewar_mahal
JWT_REFRESH_SECRET=change_me_refresh_secret_zewar_mahal
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# MessageBot SMS (OTP)
MESSAGEBOT_API_URL=https://api.messagebot.in
MESSAGEBOT_API_KEY=your_messagebot_api_key
MESSAGEBOT_SENDER_ID=ZEWARML

# Firebase (FCM)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Gold & Silver Rate Provider
RATE_PROVIDER_URL=https://your-rate-provider.com/api
RATE_PROVIDER_KEY=your_rate_provider_key

# Image Storage
STORAGE_TYPE=local
UPLOAD_PATH=./uploads

# AWS S3 (if STORAGE_TYPE=s3)
AWS_BUCKET=zewar-mahal-uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key

# Throttle (Rate Limiting)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
